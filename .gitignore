# Virtual environment
venv/
.venv/
env/

# Python cache
__pycache__/
*.py[cod]
*.pyo

# DuckDB files
*.duckdb
*.duckdb.wal

# OS files
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/

# Environment variables
.env

# Streamlit secrets (BigQuery credentials, Groq key, login password) —
# NEVER commit. Copy .streamlit/secrets.toml.example on the server instead.
.streamlit/secrets.toml

# User-specific runtime config (per-machine file paths)
outputs/file_paths_config.json

# Generated hub map images — pure display/download artifacts (write-only:
# never read back into session_state or re-used as data, unlike the CSV/
# JSON files elsewhere in outputs/, which ARE deliberately committed so
# Cloud restarts can reload them — don't extend this rule to those).
# A committed PNG here previously baked in OpenStreetMap's "Access blocked"
# tile image from before a basemap-provider fix and kept shipping with
# every deploy for 4 months; this directory should never be source-
# controlled again — the app regenerates these on demand.
outputs/Hub_Payout_Views_Final_All_Hubs/*.png

# Self-hosted deployment runtime (PIDs, logs) — see deploy/
deploy/run/
deploy/logs/
