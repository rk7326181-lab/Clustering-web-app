# ══════════════════════════════════════════════════════════════════
# Streamlit secrets — Clustering-web-app (Geo Intelligence Portal)
# ══════════════════════════════════════════════════════════════════
# Copy this file to `.streamlit/secrets.toml` on the SERVER only and
# fill in real values. `.streamlit/secrets.toml` is gitignored — it
# must never be committed. This is the same secrets mechanism the app
# already used on Streamlit Cloud; self-hosting does not change it.

# ── App login (email allowlist + shared password) ──
# If both are left empty/absent, the app allows anyone who can reach it —
# on a private Tailscale-only network that may be acceptable, but setting
# a password is recommended as a second layer.
allowed_emails = ["you@shadowfax.in", "teammate@shadowfax.in"]
app_password = "choose-a-shared-password"

# ── Groq AI Agent (Step 6) ──
# Alternative: set GROQ_API_KEY in `.env` instead (also supported — see
# .env.example). Either works; this app checks both.
GROQ_API_KEY = "gsk_..."

# ── Google BigQuery — pick ONE of the sections below ──

# Option A: personal Gmail OAuth token (expires every ~2 days under this
# workspace's session-control policy — see REFRESH_BQ_TOKEN.bat one level
# up from this repo). Generated by generate_bq_token.py.
[google_oauth]
refresh_token = "1//..."
client_id     = "764086051850-6qr4p6gpi6hn506pt8ejuq83di341hur.apps.googleusercontent.com"
client_secret = "d-FL95Q19q7MQmFpd7hHD0Ty"
token_uri     = "https://oauth2.googleapis.com/token"

# Option B: service account key (does NOT expire — recommended for a
# server that must fetch data unattended). Ask the BI/GCP team for this;
# paste the full JSON key as a TOML table below, uncomment, and delete
# [google_oauth] above.
# [gcp_credentials]
# type = "service_account"
# project_id = "..."
# private_key_id = "..."
# private_key = "-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# client_email = "...@....iam.gserviceaccount.com"
# client_id = "..."
# token_uri = "https://oauth2.googleapis.com/token"

# ── Encrypted remote token store (keeps the Gmail refresh token fresh
# automatically across both apps — see REFRESH_BQ_TOKEN.bat) ──
# GH_TOKEN = "github_pat_..."
# TOKEN_DECRYPT_KEY = "..."
